{
  "name": "@ziniao/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "cd ../.. && vitest run apps/api/src/app.test.ts apps/api/src/triggers.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@ziniao/core": "workspace:*",
    "@ziniao/flow-engine": "workspace:*",
    "@ziniao/schemas": "workspace:*",
    "@ziniao/self-heal": "workspace:*",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
