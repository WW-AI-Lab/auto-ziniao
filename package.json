{
  "name": "ziniao-scripts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/core packages/schemas",
    "typecheck": "tsc -b packages/core packages/schemas --pretty false",
    "test": "vitest run",
    "schemas:export": "tsx packages/schemas/scripts/export-json-schema.ts",
    "validate:python": "tsx scripts/validate-python-flows.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "validate:baseline": "pnpm validate:python && pnpm typecheck && pnpm test && pnpm schemas:export -- --check && pnpm security:scan"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
