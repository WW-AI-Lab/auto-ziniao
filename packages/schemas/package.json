{
  "name": "@ww-ai-lab/auto-ziniao-schemas",
  "version": "0.1.3",
  "private": true,
  "description": "Zod contracts and JSON schemas for Auto Ziniao flows and WebAdmin APIs.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WW-AI-Lab/auto-ziniao.git",
    "directory": "packages/schemas"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webadmin": {
      "types": "./dist/webadmin.d.ts",
      "import": "./dist/webadmin.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "schemas:export": "tsx scripts/export-json-schema.ts"
  },
  "dependencies": {
    "@ww-ai-lab/auto-ziniao-core": "workspace:*",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
