{
  "name": "@ww-ai-lab/auto-ziniao-core",
  "version": "0.1.2",
  "description": "Shared filesystem and error helpers for Auto Ziniao.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WW-AI-Lab/auto-ziniao.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.test.*",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
