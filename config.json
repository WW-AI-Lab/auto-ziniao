{
  "_comment": "全局配置。heal.agent 选择失败时调用哪个 Agent CLI；agents 中的 command 支持占位符 {prompt} {prompt_path} {session_key} {flow_id} {heal_id}",
  "heal": {
    "enabled": true,
    "agent": "openclaw",
    "cooldown_minutes": 60,
    "max_per_day": 5,
    "agents": {
      "openclaw": {
        "command": ["openclaw", "agent", "--session-key", "{session_key}", "--message", "{prompt}", "--deliver", "--channel", "feishu", "--timeout", "300"],
        "timeout_sec": 320
      },
      "claude": {
        "command": ["claude", "-p", "{prompt}", "--allowedTools", "Bash,Read,Write,Edit"],
        "timeout_sec": 600
      },
      "cursor-agent": {
        "command": ["cursor-agent", "-p", "{prompt}"],
        "timeout_sec": 600
      }
    }
  },
  "notify": {
    "channel": "feishu"
  }
}
